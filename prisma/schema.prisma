generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Profile {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  bio       String?
  githubUrl String?
  projects  Project[]
  createdAt DateTime  @default(now())
}

model Project {
  id            String       @id @default(uuid())
  title         String
  description   String
  repositoryUrl String
  deployUrl     String?
  profileId     String
  profile       Profile      @relation(fields: [profileId], references: [id])
  technologies  Technology[]
  feedbacks     Feedback[]
  createdAt     DateTime     @default(now())
}

model Technology {
  id       String    @id @default(uuid())
  name     String    @unique
  category String?
  projects Project[]
}

model Feedback {
  id        String   @id @default(uuid())
  author    String
  comment   String
  rating    Int
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  createdAt DateTime @default(now())
}